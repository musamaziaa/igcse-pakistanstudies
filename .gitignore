# Python
venv/
__pycache__/
*.py[cod]
*$py.class
.env
backend.log

# Node.js
nur-academy/node_modules/
nur-academy/.next/
nur-academy/out/
nur-academy/build/
nur-academy/.env*
nur-academy/dist/

# System/IDE
.DS_Store
.vscode/
.idea/
*.swp
*.log

# Runtime, user-generated data (not source)
backend/data/students/

# Large source reference material (kept locally; app serves JSON, not PDFs)
backend/data/source_docs/

# Exam-board source PDFs (24MB, only needed to rebuild grading guides).
# The distilled grading_guide.md files ARE committed — those are what ship.
backend/data/*/source_docs/

# Teaching/course material that is not an exam-board source. Kept locally for
# writing questions and memorize content; deliberately NOT under source_docs/,
# because build_grading_guides.py reads that tree and these would bloat it.
backend/data/*/reference/

# Drop zone for newly downloaded PDFs before they are filed into a subject.
Docs/
